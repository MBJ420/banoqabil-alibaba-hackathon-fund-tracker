# ─────────────────────────────────────────────────────────────────────────────
# FundTracker Advanced — Environment Variables Template
# BanoQabil × Alibaba Cloud AI Hackathon (Financial Inclusion Track)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename the copy to: backend/.env
#   2. Fill in your Alibaba Cloud DashScope API Key below
#   3. NEVER commit the .env file — it is in .gitignore!
# ─────────────────────────────────────────────────────────────────────────────

# Alibaba Cloud Model Studio (DashScope OpenAI-compatible API)
# Powering FundTracker AI: FMR PDF Parser, Macroeconomic News Sentiment & Portfolio Diagnostics
# Endpoint: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional Fallback: Google Gemini API Key
# If DashScope key is not provided, the system seamlessly falls back to Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Secret Key for Local JWT Authentication
SECRET_KEY=fundtracker_hackathon_demo_secret_key_change_in_prod

