# ─── Database (never commit the real DB — everyone starts fresh) ──────────────
*.db
*.sqlite3
fundtracker.db

# ─── PDF Drop Folder (personal financial documents — never commit) ────────────
# Each team member's PDFs live here locally. Never share these via Git.
Fund Tracker PDF Data/

# ─── Secret keys & environment variables ─────────────────────────────────────
# IMPORTANT: Never commit .env — it contains your Gemini API key!
.env
.env.local
.env.*.local

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# ─── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.npm/

# ─── Electron build output ────────────────────────────────────────────────────
out/
release/

# ─── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── IDE files (optional — remove if your team uses the same IDE) ────────────
.vscode/
.idea/
*.swp

# ─── Playwright browser cache ─────────────────────────────────────────────────
playwright/.cache/

# ─── Alembic auto-generated migration backup ─────────────────────────────────
# (keep the migrations folder itself, just ignore __pycache__ inside it)
backend/alembic/versions/__pycache__/
